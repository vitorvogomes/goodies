# ============================================================
# Goodies — variáveis de ambiente (TEMPLATE PÚBLICO)
# ============================================================
# 1. Copie para `.env`:            cp .env.example .env
# 2. Preencha `.env` com valores reais (fica no .gitignore).
# 3. Ao adicionar uma chave aqui, adicione TAMBÉM em `.env`
#    (e vice-versa). Os dois arquivos devem ter SEMPRE as
#    mesmas chaves — só os valores diferem.
# Detalhes da política: .claude/memory/security.md
# ============================================================

# ---- Database (Postgres 15 do docker compose em dev, asyncpg direto — ADR-018) ----
# Dev: Postgres do compose. Produção (Railway): ${{Postgres.DATABASE_URL}} nas variáveis da api.
DATABASE_URL=postgresql://goodies:POSTGRES_PASSWORD_AQUI@localhost:5432/goodies
# Senha do Postgres do compose (Story 1.6). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=change_me_openssl_rand_hex_24

# ---- Cache (Redis 7 local do docker compose) ----
REDIS_URL=redis://:REDIS_PASSWORD_AQUI@localhost:6379/0
# Senha do Redis do compose (Story 1.6). Gere com: openssl rand -hex 24
REDIS_PASSWORD=change_me_openssl_rand_hex_24

# ---- Operação (ADR-018 / spine AD-18) ----
# Diretório dos backups (pg_dump): FORA do repositório e fora de pasta sincronizada
# com a nuvem (OneDrive, Dropbox, Google Drive). Caminho absoluto.
BACKUP_DIR=/caminho/absoluto/fora/do/repo/goodies-backups

# ---- Auth JWT (ADR-006 — NÃO usar Supabase Auth) ----
# Gere segredos com: openssl rand -hex 32. Os TTLs (15 min / 30 dias / 90 dias) e HERMES_ENABLED=false
# ficam no código (api/config.py); defina aqui só para sobrescrever.
JWT_SECRET_KEY=change_me_openssl_rand_hex_32
JWT_REFRESH_SECRET_KEY=change_me_another_random_hex_32
HERMES_SERVICE_TOKEN_SECRET=change_me_hermes_scope_secret

# ---- Market data APIs ----
BRAPI_TOKEN=your_brapi_token          # B3 — https://brapi.dev
COINGECKO_API_KEY=your_coingecko_key  # Free - https://www.coingecko.com/
ETHERSCAN_API_KEY=your_etherscan_key  # ETH / ARB (V2 multichain) - https://etherscan.io/  (HYPE = Hyperliquid)
# RPC Solana (SOL + SPL). Default público throttla; aponte p/ Helius/QuickNode (free) p/ evitar.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# RPC HyperEVM (HYPE nativo no mesmo endereço Rabby; o scan spot L1 não enxerga este saldo).
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# ---- Binance (cron only — signed HMAC-SHA256, nunca on-demand) ----
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ---- Wallets (endereços de recebimento; privados por privacidade) ----
WALLET_RABBY_ADDRESS=0xYOUR_EVM_ADDRESS             # Rabby — ETH/ARB/PENDLE (Etherscan) + HYPE (L1 spot + HyperEVM)
WALLET_PHANTOM_SOL_ADDRESS=YOUR_SOLANA_ADDRESS      # Phantom — Solana (JSON-RPC)
WALLET_NEOBANKLESS_ADDRESS=YOUR_SOLANA_ADDRESS      # Neobankless — 2ª wallet Solana (USD/USDC)
WALLET_SIDESWAP_ADDRESS=YOUR_LIQUID_ADDRESS         # SideSwap — Liquid (L-BTC + USDT)
WALLET_TRUST_BTC_ADDRESS=bc1qYOUR_BTC_ADDRESS       # Trust — BTC mainchain (Blockstream)

# ---- LEDGER_SELF_IDENTIFIERS (ADR-007) ----
# Lista separada por vírgula. Casa por SUBSTRING case-insensitive na descrição e só
# marca "transferência interna" quando a descrição também contém "Transferência".
# IMPORTANTE: identifique suas CONTAS RASTREADAS, não a PESSOA. Os números das contas
# cadastradas (account_number) já entram automaticamente. Acrescente só o que mapeia
# UNICAMENTE p/ uma conta rastreada — ex.: o CNPJ do MEI. EVITE nome/CPF "pelados":
# eles também casam contas SUAS mas NÃO rastreadas (ex.: outro banco no seu nome), que
# devem contar como receita/despesa externa — não como transferência interna.
LEDGER_SELF_IDENTIFIERS=12.345.678/0001-90

# ---- Ficam no código (api/config.py), não aqui ----
# Servidor (ADR-018): API_HOST, PORT — padrão no código; o Railway injeta PORT. CORS_ORIGINS: não é preciso
# (o web repassa /api/v1, mesma origem em dev e produção).
# ADMIN_EMAIL/ADMIN_PASSWORD: só no bootstrap de banco vazio, passados na linha de comando ou no Railway
# (1ª subida). Ver docs/DEPLOY_RAILWAY.md e docs/LOCAL_DEV.md.
