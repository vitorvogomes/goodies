# Frontend (Next.js) — STORY-00-06 / ADR-018. Copiar para .env.local em dev.
# NEXT_PUBLIC_* é exposto ao browser e inlined no BUILD.
#
# Dev local: o browser chama a api direto.
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Produção (Railway), definidos no serviço web — ambos lidos no BUILD:
#   NEXT_PUBLIC_API_URL=            (vazio → mesma origem; o web repassa /api/v1)
#   API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8000
API_INTERNAL_URL=
